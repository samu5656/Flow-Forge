generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  name          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  passwordHash  String
  avatarUrl     String?
  githubAccount GithHubAccount?
  notifications Notification[]
  memberships   OrganizationMember[]
  refreshTokens RefreshToken[]
  teamMembers   TeamMember[]
}

model Organization {
  id          String               @id @default(uuid())
  name        String
  createdAt   DateTime             @default(now())
  slug        String               @unique
  description String?
  members     OrganizationMember[]
  projects    Project[]
  teams       Team[]
}

model OrganizationMember {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  createdAt      DateTime         @default(now())
  role           OrganizationRole
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Team {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  TeamMember     TeamMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Project {
  id             String              @id @default(uuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  slug           String
  Issue          Issue[]
  Label          Label[]
  Milestone      Milestone[]
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositories   ProjectRepository[]
  documents      ProjectDocument[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Issue {
  id          String        @id @default(uuid())
  title       String
  description String?
  projectId   String
  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Task        Task[]

  @@index([projectId])
}

model Task {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  issueId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Label {
  id        String   @id @default(uuid())
  name      String
  color     String?
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model Milestone {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model GithHubAccount {
  id           String              @id @default(uuid())
  userId       String              @unique
  githubId     String              @unique
  username     String
  accessToken  String
  avatarUrl    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories ProjectRepository[]
}

model ProjectRepository {
  id              String         @id @default(uuid())
  projectId       String
  githubRepoId    String
  owner           String
  name            String
  fullName        String
  htmlUrl         String
  defaultBranch   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  githubAccountId String
  githubAccount   GithHubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, githubRepoId])
}

model WebhookEvent {
  id                 String             @id @default(uuid())
  deliveryId         String             @unique
  eventType          String
  action             String?
  payload            Json
  repositoryFullName String?
  status             WebhookEventStatus @default(PENDING)
  error              String?
  createdAt          DateTime           @default(now())
  processedAt        DateTime?

  @@index([eventType])
  @@index([repositoryFullName])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

enum OrganizationRole {
  MEMBER
  TEAM_LEAD
  DEVOPS
  ADMIN
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED
}

model ProjectDocument {
  id          String    @id @default(uuid())
  title       String    
  content     String
  category    String    @default("GENERAL") //ARCHITECTURE,API,ONBOARDING,GENERAL

  projectId   String
  project     Project   @relation(fields: [projectId], references:[id], onDelete: Cascade)

  //We store the calculated embedding vector as a JSON array of floats [0.012,-0.045,...]
  embedding   Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  
}